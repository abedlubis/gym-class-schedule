# Local development: point straight at the backend on :8787.
VITE_API_BASE_URL=http://localhost:8787/api/v1

# In production leave this UNSET. The default is the relative path /api/v1,
# which vercel.json proxies to the backend project — same origin, so the admin
# session cookie stays first-party.

# PrimeVue 5 ("PrimeUI") requires a license key even for unstyled/free-tier
# usage, or it logs a console warning and shows an "Invalid PrimeUI License"
# banner. Get a free Community License at https://primeui.dev/licenses/community
# (eligible for teams under 5 developers) and paste it here.
VITE_PRIMEUI_LICENSE_KEY=
