# Never commit real values. Platform environment variables only in deployment.

# Neon POOLED string — hostname contains "-pooler". Used at runtime.
DATABASE_URL=

# Neon DIRECT string. Used only by db:migrate, seed:import and seed:admin,
# which set DB_DIRECT=1. Migrations fail through a transaction-mode pooler.
DIRECT_URL=

# Exact origins, comma separated. Never "*" — the admin sends credentials.
# Leave empty when the frontend proxies /api/* to this service (same origin).
CORS_ORIGINS=http://localhost:5173

NODE_ENV=development
PORT=8787

# Used once by `npm run seed:admin`, then removed. There is no self-signup.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
